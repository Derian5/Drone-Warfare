[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/guide_card.gd" id="1_gc"]
[ext_resource type="Texture2D" path="res://ui/icons/close.svg" id="2_close"]

[node name="GuideCard" type="PanelContainer"]
theme_type_variation = &"GuidePanel"
script = ExtResource("1_gc")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Stripe" type="ColorRect" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(4, 0)
layout_mode = 2
mouse_filter = 2
color = Color(0.12, 0.75, 0.8, 1)

[node name="Text" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Head" type="HBoxContainer" parent="Row/Text"]
layout_mode = 2

[node name="Kicker" type="Label" parent="Row/Text/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StrongSmall"
text = "NEXT STEP · 1 OF 4"

[node name="Hide" type="Button" parent="Row/Text/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(18, 18)
layout_mode = 2
tooltip_text = "Hide the tutorial steps (alerts still show)"
focus_mode = 0
theme_type_variation = &"IconButton"
icon = ExtResource("2_close")
icon_alignment = 1
expand_icon = true

[node name="Title" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LineName"
text = "Draw a route"
autowrap_mode = 3

[node name="Body" type="Label" parent="Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SummaryText"
text = "Press on your blue base and drag to the red Enemy HQ."
autowrap_mode = 3
