[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/dev_panel.gd" id="1_dev"]

[node name="DevPanel" type="PanelContainer"]
offset_right = 420.0
offset_bottom = 36.0
theme_type_variation = &"MapCard"
script = ExtResource("1_dev")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Collapse" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Developer tools (debug builds only). Click to fold, F9 to hide."
theme_type_variation = &"SmallButton"
text = "DEV"

[node name="Tools" type="HBoxContainer" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="SpeedLabel" type="Label" parent="Row/Tools"]
layout_mode = 2
theme_type_variation = &"MutedSmall"
text = "SPEED"

[node name="SpeedRow" type="HBoxContainer" parent="Row/Tools"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="CreditsButton" type="Button" parent="Row/Tools"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Add credits"
theme_type_variation = &"SmallButton"
text = "+1000 cr"

[node name="HuntersButton" type="Button" parent="Row/Tools"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Launch the next hunter wave now"
theme_type_variation = &"SmallButton"
text = "Hunters"

[node name="WinButton" type="Button" parent="Row/Tools"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Destroy the enemy HQ (capture the region)"
theme_type_variation = &"SmallButton"
text = "Win"
